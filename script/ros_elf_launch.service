[Unit]
Description=BXI remote controller (NVIDIA Jazzy)
After=network.target bluetooth.service systemd-modules-load.service

[Service]
Type=simple
User=root
Environment=ROS_DOMAIN_ID=0
Environment=RMW_IMPLEMENTATION=rmw_fastrtps_cpp
Environment=ROS_LOCALHOST_ONLY=1
Environment=ROS_AUTOMATIC_DISCOVERY_RANGE=LOCALHOST
ExecStart=/bin/bash -c "source /opt/ros/jazzy/setup.bash && source /opt/bxi/bxi_ros2_pkg/local_setup.bash && source /opt/bxi/bxi_rl_controller_ros2_example/install/local_setup.bash && exec ros2 launch remote_controller remote_controller.launch.py"
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
